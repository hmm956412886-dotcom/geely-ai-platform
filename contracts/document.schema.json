{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedKnowledgeDocument",
  "type": "object",
  "required": [
    "document_id",
    "source_type",
    "title",
    "source_url",
    "updated_at",
    "sections"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "feishu_docx",
        "feishu_sheet",
        "feishu_base",
        "feishu_file"
      ]
    },
    "space_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "node_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "acl": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "principal_type",
          "principal_id",
          "permission"
        ],
        "properties": {
          "principal_type": {
            "type": "string",
            "enum": [
              "user",
              "department",
              "group",
              "app",
              "role"
            ]
          },
          "principal_id": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "admin"
            ]
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "heading_path",
          "content"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "heading_path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content": {
            "type": "string"
          },
          "page_no": {
            "type": [
              "integer",
              "null"
            ]
          },
          "block_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}

