{
  "openapi": "3.0.3",
  "info": {
    "title": "Geely AI Gateway",
    "version": "0.1.0",
    "description": "Stable REST contract for the embedded CoreTest workspace agent, trusted host state, and deterministic analysis."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer"},
      "hostBearerAuth": {"type": "http", "scheme": "bearer", "description": "Privileged desktop host token"}
    },
    "parameters": {
      "HostSessionId": {
        "name": "host_session_id",
        "in": "query",
        "required": false,
        "schema": {"type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$", "default": "default"}
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["request_id", "error"],
        "properties": {
          "request_id": {"type": "string"},
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
          }
        }
      },
      "HostContext": {
        "type": "object",
        "properties": {
          "host_session_id": {"type": "string"},
          "host_application": {"type": "string", "nullable": true},
          "project_id": {"type": "string", "nullable": true},
          "project_label": {"type": "string", "nullable": true},
          "run_id": {"type": "string", "nullable": true},
          "source_asset_id": {"type": "string", "nullable": true},
          "target_asset_id": {"type": "string", "nullable": true},
          "current_view": {"type": "string", "nullable": true},
          "user_id": {"type": "string", "nullable": true},
          "selection_kind": {"type": "string", "nullable": true, "enum": ["project", "file", "trace", "dbc", "diagnostic", "pdx", null]},
          "selection_label": {"type": "string", "nullable": true},
          "snapshot_revision": {"type": "string", "nullable": true}
        }
      },
      "HostContextUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "host_application": {"type": "string", "nullable": true},
          "project_id": {"type": "string", "nullable": true},
          "project_label": {"type": "string", "nullable": true},
          "run_id": {"type": "string", "nullable": true},
          "source_asset_id": {"type": "string", "nullable": true},
          "target_asset_id": {"type": "string", "nullable": true},
          "current_view": {"type": "string", "nullable": true},
          "user_id": {"type": "string", "nullable": true},
          "selection_kind": {"type": "string", "nullable": true, "enum": ["project", "file", "trace", "dbc", "diagnostic", "pdx", null]},
          "selection_label": {"type": "string", "nullable": true},
          "snapshot_revision": {"type": "string", "nullable": true}
        }
      },
      "HostSnapshot": {
        "type": "object",
        "required": ["kind", "revision", "data"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "enum": ["project", "file", "trace", "dbc", "diagnostic", "pdx"]},
          "revision": {"type": "string", "maxLength": 80},
          "captured_at": {"type": "string", "nullable": true},
          "selection": {"type": "object", "additionalProperties": true},
          "data": {"type": "object", "additionalProperties": true}
        }
      },
      "WorkspaceRegistration": {
        "type": "object",
        "required": ["project_root"],
        "additionalProperties": false,
        "properties": {
          "project_root": {"type": "string", "description": "Absolute workspace directory accepted only from the trusted desktop host; never returned to the WebView"}
        }
      },
      "CopilotAttachment": {
        "type": "object",
        "required": ["name", "content"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "description": "Basename of a supported UTF-8 text file; maximum encoded content size is 256 KiB"},
          "content": {"type": "string"}
        }
      },
      "CopilotArtifact": {
        "type": "object",
        "required": ["name", "language", "content"],
        "properties": {
          "name": {"type": "string"},
          "language": {"type": "string", "enum": ["python"]},
          "content": {"type": "string"}
        }
      },
      "CopilotQueryRequest": {
        "type": "object",
        "required": ["question"],
        "additionalProperties": false,
        "properties": {
          "question": {"type": "string", "minLength": 1, "maxLength": 4000},
          "conversation_id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$"},
          "task": {"type": "string", "enum": ["chat", "generate_test"], "default": "chat"},
          "history": {
            "type": "array",
            "maxItems": 20,
            "description": "Conversation messages preceding the current question; maximum combined content size is 64 KiB",
            "items": {
              "type": "object",
              "required": ["role", "content"],
              "additionalProperties": false,
              "properties": {
                "role": {"type": "string", "enum": ["user", "assistant"]},
                "content": {"type": "string", "minLength": 1}
              }
            }
          },
          "attachments": {"type": "array", "maxItems": 5, "items": {"$ref": "#/components/schemas/CopilotAttachment"}, "description": "Maximum combined encoded content size is 512 KiB"}
        }
      },
      "CopilotQueryResponse": {
        "type": "object",
        "required": ["request_id", "answer", "artifacts", "citations", "warnings"],
        "properties": {
          "request_id": {"type": "string"},
          "answer": {"type": "string"},
          "artifacts": {"type": "array", "items": {"$ref": "#/components/schemas/CopilotArtifact"}},
          "citations": {"type": "array", "items": {"type": "object"}},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      },
      "AgentConversationRequest": {
        "type": "object",
        "required": ["conversation_id"],
        "additionalProperties": false,
        "properties": {
          "conversation_id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$"}
        }
      },
      "AgentPermissionReply": {
        "type": "object",
        "required": ["conversation_id", "request_id", "reply"],
        "additionalProperties": false,
        "properties": {
          "conversation_id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$"},
          "request_id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$"},
          "reply": {"type": "string", "enum": ["once", "reject"]}
        }
      }
    },
    "responses": {
      "BadRequest": {"description": "Invalid request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Unauthorized": {"description": "Bearer token is missing or invalid", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "ModelUnavailable": {"description": "Model is not configured or unavailable", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
    }
  },
  "security": [{"bearerAuth": []}, {}],
  "paths": {
    "/health": {"get": {"summary": "Health check", "security": [], "responses": {"200": {"description": "Gateway is healthy"}}}},
    "/showcase": {"get": {"summary": "CoreTest integration showcase", "security": [], "responses": {"200": {"description": "HTML showcase"}}}},
    "/copilot": {"get": {"summary": "Embeddable Copilot side panel", "security": [], "responses": {"200": {"description": "Copilot HTML"}}}},
    "/copilot-shell/": {"get": {"summary": "Embeddable Copilot frontend", "security": [], "responses": {"200": {"description": "Copilot HTML"}}}},
    "/plugin-manifest.json": {"get": {"summary": "Host integration manifest", "security": [], "responses": {"200": {"description": "Plugin manifest"}}}},
    "/api/v1/model/config": {"get": {"summary": "Return public model runtime config", "responses": {"200": {"description": "Model config without API key"}}}},
    "/api/v1/agent/status": {"get": {"summary": "Return browser-safe workspace and OpenCode Runtime status", "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "responses": {"200": {"description": "Runtime status without paths, passwords, or API keys"}}}},
    "/api/v1/agent/permissions": {"post": {"summary": "Return pending OpenCode permissions for one conversation", "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentConversationRequest"}}}}, "responses": {"200": {"description": "Browser-safe pending permission requests"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/agent/activity": {"post": {"summary": "Return browser-safe OpenCode tool activity for one conversation", "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentConversationRequest"}}}}, "responses": {"200": {"description": "Recent tool activity without absolute workspace paths"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/agent/permissions/reply": {"post": {"summary": "Allow one OpenCode tool call or reject it", "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentPermissionReply"}}}}, "responses": {"200": {"description": "Permission reply accepted"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/agent/abort": {"post": {"summary": "Abort the active OpenCode turn for one conversation", "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentConversationRequest"}}}}, "responses": {"200": {"description": "Abort request accepted"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/v1/host/context": {
      "parameters": [{"$ref": "#/components/parameters/HostSessionId"}],
      "get": {"summary": "Return host context", "responses": {"200": {"description": "Current context"}}},
      "post": {"summary": "Update host context", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HostContextUpdate"}}}}, "responses": {"200": {"description": "Updated context"}, "400": {"$ref": "#/components/responses/BadRequest"}}}
    },
    "/api/v1/host/assets": {"post": {"summary": "Register a host-local file", "x-required-token": "host", "security": [{"hostBearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "responses": {"200": {"description": "Browser-safe asset ID"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/host/workspace": {"post": {"summary": "Register the trusted workspace and start the OpenCode Runtime", "x-required-token": "host", "security": [{"hostBearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkspaceRegistration"}}}}, "responses": {"200": {"description": "Browser-safe workspace and Runtime status"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/host/snapshot": {
      "parameters": [{"$ref": "#/components/parameters/HostSessionId"}],
      "get": {"summary": "Return bounded host snapshot", "responses": {"200": {"description": "Current snapshot"}}},
      "post": {"summary": "Publish bounded host snapshot", "x-required-token": "host", "security": [{"hostBearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HostSnapshot"}}}}, "responses": {"200": {"description": "Stored snapshot"}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
    "/api/v1/host/snapshot/analyze": {"post": {"summary": "Analyze the current host snapshot with OpenCode", "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "responses": {"200": {"description": "OpenCode analysis"}, "400": {"$ref": "#/components/responses/BadRequest"}, "502": {"$ref": "#/components/responses/ModelUnavailable"}}}},
    "/api/v1/copilot/query": {
      "post": {
        "summary": "Chat or generate pytest from bounded text attachments",
        "parameters": [{"$ref": "#/components/parameters/HostSessionId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CopilotQueryRequest"}}}},
        "responses": {
          "200": {"description": "Model response and optional generated pytest artifact", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CopilotQueryResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "502": {"$ref": "#/components/responses/ModelUnavailable"}
        }
      }
    },
    "/api/v1/host/session": {"delete": {"summary": "Release host session", "x-required-token": "host", "security": [{"hostBearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "responses": {"200": {"description": "Session released"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/audit/events": {"get": {"summary": "Return recent audit events", "responses": {"200": {"description": "Recent events"}}}},
    "/api/v1/analyze": {"post": {"summary": "Parse test data and analyze it with OpenCode", "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "responses": {"200": {"description": "OpenCode analysis with parsed test facts"}, "400": {"$ref": "#/components/responses/BadRequest"}, "502": {"$ref": "#/components/responses/ModelUnavailable"}}}},
    "/api/v1/test-data/summary": {"post": {"summary": "Return test run summary", "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "responses": {"200": {"description": "Summary"}}}},
    "/api/v1/test-data/compare": {"post": {"summary": "Compare test runs", "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "responses": {"200": {"description": "Comparison"}}}},
    "/api/v1/test-data/insights": {"post": {"summary": "Return deterministic test data insights", "parameters": [{"$ref": "#/components/parameters/HostSessionId"}], "responses": {"200": {"description": "Insights"}}}}
  }
}
