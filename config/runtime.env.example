# Copy this file to .env or pass it to scripts/start-ai-gateway.ps1 -EnvFile.
# Do not commit real API keys.

AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=8765

# Both are required when the Gateway is exposed beyond a trusted local machine.
# Never place AI_GATEWAY_HOST_TOKEN in a WebView URL.
AI_GATEWAY_ACCESS_TOKEN=
AI_GATEWAY_HOST_TOKEN=
AI_GATEWAY_MAX_HOST_SESSIONS=256
AI_GATEWAY_MAX_ASSETS_PER_SESSION=32

# OpenAI-compatible model API. Leave empty to use deterministic local fallback.
AI_MODEL_BASE_URL=
AI_MODEL_API_KEY=
AI_MODEL_NAME=
AI_MODEL_TIMEOUT_SECONDS=30

# Optional real Feishu search. Keep demo for offline delivery.
AI_KNOWLEDGE_PROVIDER=demo
LARK_CLI_COMMAND=lark-cli.exe

# Optional customer host software API.
TEST_SOFTWARE_API_BASE_URL=
TEST_SOFTWARE_API_TOKEN=
