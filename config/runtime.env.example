# Optional unattended deployment template for scripts/start-ai-gateway.ps1 -EnvFile.
# Normal CoreTest users configure providers in the Agent sidebar and do not need this file.
# Do not commit real API keys.

AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=8765

# Both are required when the Gateway is exposed beyond a trusted local machine.
# Never place AI_GATEWAY_HOST_TOKEN in a WebView URL.
AI_GATEWAY_ACCESS_TOKEN=
AI_GATEWAY_HOST_TOKEN=
AI_GATEWAY_MAX_HOST_SESSIONS=256
AI_GATEWAY_MAX_ASSETS_PER_SESSION=32

# Optional legacy model import. Leave blank when providers are configured in the Agent sidebar.
AI_MODEL_BASE_URL=
AI_MODEL_API_KEY=
AI_MODEL_NAME=
AI_MODEL_TIMEOUT_SECONDS=30

# OpenCode workspace Agent Sidecar. Development may use an opencode command on PATH.
# Production delivery should pin OPENCODE_COMMAND to the bundled executable.
OPENCODE_COMMAND=auto
OPENCODE_ALLOW_DOWNLOAD=false
OPENCODE_HOST=127.0.0.1
# Leave blank to select an unused local port and avoid stale-process conflicts.
OPENCODE_PORT=
OPENCODE_HEALTH_TIMEOUT_SECONDS=2
