[
  {
    "name": "copilot_page",
    "method": "GET",
    "path": "/copilot",
    "expect_status": 200,
    "body_contains": "Geely AI Copilot"
  },
  {
    "name": "copilot_shell_page",
    "method": "GET",
    "path": "/copilot-shell/",
    "expect_status": 200,
    "body_contains": "Geely AI Copilot Shell"
  },
  {
    "name": "showcase_page",
    "method": "GET",
    "path": "/showcase",
    "expect_status": 200,
    "body_contains": "Geely Test AI Workbench"
  },
  {
    "name": "summarize_csv",
    "method": "POST",
    "path": "/api/v1/test-data/summary?host_session_id=eval-session",
    "body": {
      "source_asset_id": "eval-current"
    },
    "expect_status": 200,
    "expect": {
      "result.run_id": "RUN_CSV_001",
      "result.failed_cases": 1
    },
    "prefix": {
      "request_id": "req_"
    }
  },
  {
    "name": "host_context_roundtrip",
    "method": "POST",
    "path": "/api/v1/host/context?host_session_id=eval-session",
    "body": {
      "host_application": "HK CoreTest",
      "project_id": "vehicle-eval",
      "run_id": "RUN_HOST_001",
      "source_asset_id": "eval-current",
      "target_asset_id": "eval-target",
      "current_view": "测试结果 / 运行详情",
      "user_id": "tester"
    },
    "expect_status": 200,
    "expect": {
      "result.run_id": "RUN_HOST_001",
      "result.current_view": "测试结果 / 运行详情"
    },
    "prefix": {
      "request_id": "req_"
    }
  },
  {
    "name": "publish_host_snapshot",
    "method": "POST",
    "path": "/api/v1/host/snapshot?host_session_id=eval-coretest",
    "body": {
      "kind": "trace",
      "revision": "1",
      "selection": {
        "frame_id": "0x123"
      },
      "data": {
        "total_frames": 120,
        "duration_seconds": 2.5,
        "error_frames": 3,
        "top_frame_ids": [
          {
            "frame_id": "0x123",
            "count": 40
          }
        ]
      }
    },
    "host_privileged": true,
    "expect_status": 200,
    "expect": {
      "result.kind": "trace",
      "result.revision": "1"
    }
  },
  {
    "name": "copilot_requires_workspace",
    "method": "POST",
    "path": "/api/v1/copilot/query?host_session_id=eval-coretest",
    "body": {
      "question": "解释当前项目"
    },
    "expect_status": 502,
    "expect": {
      "error.code": "model_unavailable"
    },
    "contains": {
      "error.message": "workspace is not registered"
    }
  },
  {
    "name": "snapshot_analysis_requires_workspace",
    "method": "POST",
    "path": "/api/v1/host/snapshot/analyze?host_session_id=eval-coretest",
    "body": {
      "question": "分析当前 Trace"
    },
    "expect_status": 502,
    "expect": {
      "error.code": "model_unavailable"
    },
    "contains": {
      "error.message": "workspace is not registered"
    }
  },
  {
    "name": "register_host_asset",
    "method": "POST",
    "path": "/api/v1/host/assets?host_session_id=eval-session",
    "body": {
      "asset_id": "eval-current",
      "file_path": "${FIXTURES}/test-run-cases.csv"
    },
    "host_privileged": true,
    "expect_status": 200,
    "expect": {
      "result.asset_id": "eval-current",
      "result.media_type": "text/csv"
    }
  },
  {
    "name": "summarize_host_asset",
    "method": "POST",
    "path": "/api/v1/test-data/summary?host_session_id=eval-session",
    "body": {
      "source_asset_id": "eval-current"
    },
    "expect_status": 200,
    "expect": {
      "result.source.type": "host_asset",
      "result.source.ref": "eval-current"
    }
  },
  {
    "name": "compare_runs",
    "method": "POST",
    "path": "/api/v1/test-data/compare?host_session_id=eval-session",
    "body": {
      "baseline_asset_id": "eval-current",
      "target_asset_id": "eval-target"
    },
    "expect_status": 200,
    "expect": {
      "result.baseline_run_id": "RUN_CSV_001",
      "result.target_run_id": "RUN_CSV_002",
      "result.changed_metrics.2.delta": 1
    },
    "contains": {
      "result.summary": "失败用例增加 1 个"
    }
  },
  {
    "name": "test_data_insights",
    "method": "POST",
    "path": "/api/v1/test-data/insights?host_session_id=eval-session",
    "body": {
      "source_asset_id": "eval-current"
    },
    "expect_status": 200,
    "expect": {
      "result.run_id": "RUN_CSV_001",
      "result.failed_cases": 1,
      "result.failure_reasons.0.reason": "扭矩误差超过阈值"
    },
    "prefix": {
      "request_id": "req_"
    }
  },
  {
    "name": "audit_events",
    "method": "GET",
    "path": "/api/v1/audit/events",
    "expect_status": 200,
    "expect": {
      "result.events.0.path": "/api/v1/test-data/summary"
    }
  },
  {
    "name": "release_host_session",
    "method": "DELETE",
    "path": "/api/v1/host/session?host_session_id=eval-session",
    "host_privileged": true,
    "expect_status": 200,
    "expect": {
      "result.host_session_id": "eval-session",
      "result.released_context": true,
      "result.released_assets": 2
    }
  },
  {
    "name": "invalid_json_error",
    "method": "POST",
    "path": "/api/v1/analyze",
    "body_raw": "{bad",
    "expect_status": 400,
    "expect": {
      "error.code": "invalid_json"
    },
    "prefix": {
      "request_id": "req_"
    }
  },
  {
    "name": "missing_file_error",
    "method": "POST",
    "path": "/api/v1/host/assets?host_session_id=eval-session",
    "body": {
      "file_path": "${FIXTURES}/missing.csv"
    },
    "host_privileged": true,
    "expect_status": 400,
    "expect": {
      "error.code": "bad_request"
    },
    "contains": {
      "error.message": "does not exist"
    }
  }
]
